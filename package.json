{
  "name": "trails",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && node scripts/setup.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler d1 execute DB --remote --file=./schema.sql --yes && wrangler deploy",
    "db:migrate": "wrangler d1 execute DB --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute DB --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.135.0"
  }
}
