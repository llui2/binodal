{
  "name": "scholia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute scholia --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute scholia --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260925.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.40.2"
  }
}
